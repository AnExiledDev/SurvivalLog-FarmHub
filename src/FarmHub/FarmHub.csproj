<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>FarmHub</AssemblyName>
    <RootNamespace>FarmHub</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">D:\Games\Survival Log\Survival Log</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
    <ToolkitDll Condition="'$(ToolkitDll)' == ''">D:\devnew\game-mods\SurvivalLog\mods\sl-exiled-toolkit\src\ExiledToolkit\bin\Release\ExiledToolkit.dll</ToolkitDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)\AOT.dll" Private="false" />
    <Reference Include="$(Interop)\HotUpdate.dll" Private="false" />
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Interop)\Vuplex.WebView.dll" Private="false" />
    <Reference Include="$(ToolkitDll)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="page.js" LogicalName="FarmHub.page.js" />
  </ItemGroup>

  <!-- What the Mod Manager's Mods screen shows about this mod. -->
  <ItemGroup>
    <AssemblyMetadata Include="ModManager.Name" Value="Farm Hub&#10;农场中心" />
    <AssemblyMetadata Include="ModManager.Description" Value="One window for every planter pot in your home. See each pot's crop, time to ripe, time before it rots and its problems by floor and room, plant every empty pot from a preset in one press, and fertilize or tend them. Planting presets set an order of seeds for each pot size and an order of fertilizers, with fallbacks for when one runs out, and fertilizer per crop. A forecast shows harvests and spoil deadlines for the next two days. Opens from a HUD button.&#10;一个窗口管理家中所有种植盆：按楼层和房间查看每个盆的作物、成熟剩余时间、腐烂前剩余时间和问题，一键按预设为所有空盆播种，还可以施肥和照料。种植预设可以为每种盆的大小设定种子顺序和肥料顺序，用完时自动换下一个，并可为每种作物单独设定肥料。预报会显示未来两天的收获和腐烂期限。用 HUD 按钮打开。" />
    <AssemblyMetadata Include="ModManager.Author" Value="AnExiledDev" />
    <AssemblyMetadata Include="ModManager.Category" Value="QualityOfLife" />
    <AssemblyMetadata Include="ModManager.GameVersion" Value="1.1.20719" />
    <AssemblyMetadata Include="ModManager.Settings" Value="Restart" />
    <AssemblyMetadata Include="ModManager.GitHub" Value="AnExiledDev/SurvivalLog-FarmHub" />
    <AssemblyMetadata Include="ModManager.Changelog" Value="https://github.com/AnExiledDev/SurvivalLog-FarmHub/blob/main/CHANGELOG.md" />
  </ItemGroup>

</Project>
